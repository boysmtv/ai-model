# Optional Hugging Face token for faster and more reliable Open WebUI downloads.
HF_TOKEN=

# Optional OpenClaw + Telegram setup.
# Keep the real Telegram token in your local .env only; never commit it.
TELEGRAM_BOT_TOKEN=
